{
  "name": "latelier",
  "productName": "L'Atelier",
  "private": true,
  "version": "0.17.1",
  "description": "A desktop MongoDB client — connect, browse, query and edit MongoDB, built on Electron, Vite and React.",
  "license": "MIT",
  "author": "Anonhym",
  "homepage": "https://github.com/anonhym/latelier",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anonhym/latelier.git"
  },
  "bugs": {
    "url": "https://github.com/anonhym/latelier/issues"
  },
  "keywords": [
    "mongodb",
    "electron",
    "database",
    "gui",
    "desktop",
    "mongo",
    "client"
  ],
  "engines": {
    "node": ">=24.15 <25"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.5"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build-win": "tsc -b && vite build && electron-builder --win --x64",
    "electron:build-mac": "tsc -b && vite build && electron-builder",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:component": "vitest run --project component",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "bash scripts/run-e2e.sh",
    "test:mutation": "stryker run",
    "audit:ipc": "node scripts/audit-ipc.mjs",
    "fonts:fetch": "node scripts/fetch-fonts.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "bson": "^7.3.1",
    "electron-updater": "6.8.9",
    "mongodb": "^7.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.8",
    "@eslint/js": "^10.0.1",
    "@lezer/common": "^1.5.2",
    "@mantine/core": "^9.7.3",
    "@mantine/form": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@mantine/modals": "^9.7.3",
    "@mantine/notifications": "^9.7.3",
    "@mantine/spotlight": "^9.7.3",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tabler/icons-react": "^3.46.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "acorn": "^8.18.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fast-check": "^4.9.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "mongodb-connection-string-url": "^7.0.2",
    "mongodb-memory-server": "^11.2.0",
    "playwright": "^1.63.0",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.14.1",
    "react-router-dom": "^7.18.3",
    "react-window": "^2.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "^6.16.0"
    }
  }
}
